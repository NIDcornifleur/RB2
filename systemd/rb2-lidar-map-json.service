[Unit]
Description=RB2 LIDAR map JSON bridge
After=rb2-bringup.service
Wants=rb2-bringup.service

[Service]
Type=simple
User=rj
WorkingDirectory=/opt/rb2
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/rj/rb2_ros2_ws/install/setup.bash && python3 /opt/rb2/rb2_lidar_map_json.py'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
