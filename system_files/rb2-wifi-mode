#!/usr/bin/env bash
set -u

PATH=/usr/sbin:/usr/bin:/sbin:/bin

LOCAL_IF="wlan0"
AP_IF="wlxXXXXXXXXXXXX"
ZERO_IF="eth0"
WIFI_5G_CONF="/etc/rb2-wifi-5g.conf"

action="${1:-status}"

network_id_for_ssid() {
  local target_ssid="$1"
  wpa_cli -i "$LOCAL_IF" list_networks 2>/dev/null | awk -F'\t' -v ssid="$target_ssid" '$2==ssid {print $1; exit}'
}

select_by_ssid() {
  local target_ssid="$1"
  local id
  id=$(network_id_for_ssid "$target_ssid")
  if [ -z "$id" ]; then
    echo "SSID_NOT_FOUND:$target_ssid"
    return 1
  fi
  ip link set "$LOCAL_IF" up >/dev/null 2>&1 || true
  wpa_cli -i "$LOCAL_IF" select_network "$id" >/dev/null 2>&1
  echo "SELECTED:$target_ssid(id=$id)"
}

# WIFI-MAISON-5G n'est volontairement pas dans le netplan permanent (pas de champ
# priorité côté netplan pour forcer le 2,4G au démarrage) : ce réseau est ajouté
# ici à la volée, seulement en mémoire (jamais sauvegardé), donc un redémarrage
# du Pi revient toujours au 2,4G par défaut sans intervention.
select_5g() {
  if [ ! -r "$WIFI_5G_CONF" ]; then
    echo "CONF_5G_MANQUANTE:$WIFI_5G_CONF"
    return 1
  fi

  local WIFI_5G_SSID WIFI_5G_PSK
  # shellcheck disable=SC1090
  . "$WIFI_5G_CONF"

  if [ -z "${WIFI_5G_SSID:-}" ] || [ -z "${WIFI_5G_PSK:-}" ]; then
    echo "CONF_5G_INCOMPLETE"
    return 1
  fi

  local id
  id=$(network_id_for_ssid "$WIFI_5G_SSID")
  if [ -z "$id" ]; then
    id=$(wpa_cli -i "$LOCAL_IF" add_network 2>/dev/null)
    if ! [[ "$id" =~ ^[0-9]+$ ]]; then
      echo "ECHEC_AJOUT_RESEAU_5G"
      return 1
    fi
    wpa_cli -i "$LOCAL_IF" set_network "$id" ssid "\"$WIFI_5G_SSID\"" >/dev/null 2>&1
    wpa_cli -i "$LOCAL_IF" set_network "$id" psk "\"$WIFI_5G_PSK\"" >/dev/null 2>&1
    wpa_cli -i "$LOCAL_IF" enable_network "$id" >/dev/null 2>&1
  fi

  ip link set "$LOCAL_IF" up >/dev/null 2>&1 || true
  wpa_cli -i "$LOCAL_IF" select_network "$id" >/dev/null 2>&1
  echo "SELECTED:$WIFI_5G_SSID(id=$id)"
}

# Désactive l'auto-reconnexion de tous les profils Wi-Fi connus sauf celui
# qu'on garde (nom vide = aucune exception). Sert à empêcher un réseau connu
# épinglé en priorité (ex. WIFI-MAISON-5G-nanoHD, autoconnect-priority=10) de
# reprendre la main tout seul après une connexion explicite à un SSID client :
# quand l'opérateur demande ce SSID précis, c'est un ordre, pas une préférence
# parmi d'autres.
disable_other_wifi_autoconnect() {
  local keep_name="${1:-}"
  local name type
  while IFS=: read -r name type; do
    [ "$type" = "802-11-wireless" ] || continue
    [ -n "$keep_name" ] && [ "$name" = "$keep_name" ] && continue
    nmcli connection modify "$name" connection.autoconnect no >/dev/null 2>&1 || true
  done < <(nmcli -t -f NAME,TYPE connection show)
}

# Réactive l'auto-reconnexion de tous les profils Wi-Fi connus. Appelé par
# bureau/wifi_24g/wifi_5g : ce sont les actions explicites de retour au
# réseau habituel, donc le moment logique de lever le blocage posé par
# connect_ssid.
restore_wifi_autoconnect() {
  local name type
  while IFS=: read -r name type; do
    [ "$type" = "802-11-wireless" ] || continue
    nmcli connection modify "$name" connection.autoconnect yes >/dev/null 2>&1 || true
  done < <(nmcli -t -f NAME,TYPE connection show)
}

# Réactive wlan0 et le connecte au meilleur profil Wi-Fi local connu et
# disponible (le "device connect" seul ne suffit pas s'il ne trouve rien,
# d'où le repli qui tente chaque profil 802-11-wireless connu un par un).
# Partagé entre bureau et disconnect_client.
reconnect_local_wifi() {
  ip link set "$LOCAL_IF" up >/dev/null 2>&1 || true
  nmcli device set "$LOCAL_IF" managed yes >/dev/null 2>&1 || true
  sleep 1
  nmcli device connect "$LOCAL_IF" >/dev/null 2>&1 || true

  if ! ip -4 addr show "$LOCAL_IF" 2>/dev/null | grep -q "inet "; then
    local name type
    while IFS=: read -r name type; do
      [ "$type" = "802-11-wireless" ] || continue
      nmcli connection up "$name" ifname "$LOCAL_IF" >/dev/null 2>&1 && break
    done < <(nmcli -t -f NAME,TYPE connection show)
  fi
}

# Rejoint un réseau Wi-Fi arbitraire (site client) sur wlan0, via nmcli qui
# gère à la fois l'ajout du profil et la connexion en une seule commande, et
# persiste le profil normalement (contrairement à select_5g ci-dessus, pas de
# raison ici d'éviter la persistance : ce SSID ne sera plus à portée une fois
# RB2 reparti du site). Mot de passe vide accepté (réseau ouvert).
connect_ssid() {
  local target_ssid="$1"
  local target_pass="${2:-}"

  if [ -z "$target_ssid" ]; then
    echo "SSID_VIDE"
    return 1
  fi

  ip link set "$LOCAL_IF" up >/dev/null 2>&1 || true
  nmcli device set "$LOCAL_IF" managed yes >/dev/null 2>&1 || true

  # Ordre explicite de l'opérateur : ce SSID doit gagner, sans discussion.
  disable_other_wifi_autoconnect "$target_ssid"

  local out rc
  if [ -n "$target_pass" ]; then
    out=$(nmcli --wait 25 device wifi connect "$target_ssid" password "$target_pass" ifname "$LOCAL_IF" 2>&1)
  else
    out=$(nmcli --wait 25 device wifi connect "$target_ssid" ifname "$LOCAL_IF" 2>&1)
  fi
  rc=$?

  if [ $rc -eq 0 ]; then
    # Priorité maximale pour que ce profil gagne aussi toute réévaluation
    # future tant qu'il existe, même si un autre profil était réactivé
    # entretemps.
    nmcli connection modify "$target_ssid" connection.autoconnect-priority 999 >/dev/null 2>&1 || true
    echo "CONNECTE:$target_ssid"
  else
    echo "ECHEC_CONNEXION:$target_ssid"
    echo "$out"
  fi
  return $rc
}

status_report() {
  echo "=== RB2 NETWORK MODE STATUS ==="
  echo
  echo "--- nmcli device status ---"
  nmcli device status || true
  echo
  echo "--- ip -br addr ---"
  ip -br addr show lo "$ZERO_IF" "$LOCAL_IF" "$AP_IF" 2>/dev/null || ip -br addr
  echo
  echo "--- ping Zero 2 W camera ---"
  ping -c 1 -W 1 10.50.0.20 >/dev/null 2>&1 && echo "ZERO_ETH=OK" || echo "ZERO_ETH=NO_REPLY"
}

case "$action" in
  terrain)
    echo "Passage en MODE TERRAIN : coupure du Wi-Fi local wlan0."
    nmcli device disconnect "$LOCAL_IF" >/dev/null 2>&1 || true
    nmcli device set "$LOCAL_IF" managed no >/dev/null 2>&1 || true
    ip link set "$LOCAL_IF" down >/dev/null 2>&1 || true
    echo "MODE_TERRAIN_OK"
    echo "wlan0 coupé."
    echo "AP RB2 conservé sur $AP_IF."
    ;;

  bureau)
    echo "Passage en MODE BUREAU : réactivation du Wi-Fi local wlan0."
    restore_wifi_autoconnect
    reconnect_local_wifi
    echo "MODE_BUREAU_REQUESTED"
    echo "wlan0 réactivé si un profil Wi-Fi local valide existe."
    echo "AP RB2 conservé sur $AP_IF."
    ;;

  wifi_24g)
    echo "Bascule vers bande 2,4 GHz (WIFI-MAISON-2.4G)."
    restore_wifi_autoconnect
    select_by_ssid "WIFI-MAISON-2.4G"
    ;;

  wifi_5g)
    echo "Bascule vers bande 5 GHz (WIFI-MAISON-5G)."
    restore_wifi_autoconnect
    select_5g
    ;;

  disconnect_client)
    echo "Déconnexion du Wi-Fi client, retour au réseau local RB2."
    restore_wifi_autoconnect
    nmcli device disconnect "$LOCAL_IF" >/dev/null 2>&1 || true
    sleep 1
    reconnect_local_wifi
    echo "DECONNEXION_OK"
    echo "AP RB2 conservé sur $AP_IF."
    ;;

  connect_ssid)
    echo "Connexion à un réseau Wi-Fi client (SSID fourni)."
    connect_ssid "${2:-}" "${3:-}"
    # Les autres actions ci-dessus laissent tomber jusqu'au "exit 0" final
    # sans se soucier du code de sortie de leur fonction (ce qui est
    # rattrapé côté page par un sondage de confirmation sur /rb2_network/status
    # pour wifi_24g/wifi_5g). connect_ssid n'a pas cet équivalent de sondage
    # utile (nouveau SSID arbitraire, pas une bande connue) : il faut donc
    # que le vrai code de sortie de nmcli remonte jusqu'à Python ici.
    exit $?
    ;;

  status)
    status_report
    ;;

  *)
    echo "Usage: $0 {terrain|bureau|wifi_24g|wifi_5g|connect_ssid SSID [MOT_DE_PASSE]|disconnect_client|status}" >&2
    exit 2
    ;;
esac

exit 0
