# Autorisation limitee pour la page de secours locale du Zero 2 W
# Fichier reel sur le Zero : /etc/sudoers.d/rb2-zero-secours-local

rj ALL=(root) NOPASSWD: /usr/bin/systemctl restart rb2-zero-cam.service
rj ALL=(root) NOPASSWD: /usr/bin/systemctl restart --no-block rb2-zero-cam.service

# Bouton « COUPER secours Zero + rebrancher reseau local » de la page de secours.
# Le retour au reseau local se fait via nmcli, qui exige root sans session polkit.
rj ALL=(root) NOPASSWD: /usr/bin/python3 /home/rj/rb2_zero_secours/rb2_zero_secours_auto.py --restore
