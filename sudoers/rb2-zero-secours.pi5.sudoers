# Autorisations limitees pour la page de secours du Zero 2 W
# Fichier reel sur le Pi5 : /etc/sudoers.d/rb2-zero-secours

rj ALL=(root) NOPASSWD: /usr/bin/systemctl restart rb2-esp32-panel.service
rj ALL=(root) NOPASSWD: /usr/bin/systemctl restart --no-block rb2-esp32-panel.service

rj ALL=(root) NOPASSWD: /usr/bin/systemctl restart rb2-bringup.service
rj ALL=(root) NOPASSWD: /usr/bin/systemctl restart --no-block rb2-bringup.service

rj ALL=(root) NOPASSWD: /usr/bin/systemctl restart rb2-lidar-json.service
rj ALL=(root) NOPASSWD: /usr/bin/systemctl restart --no-block rb2-lidar-json.service

rj ALL=(root) NOPASSWD: /usr/bin/systemctl restart rb2-lidar-map-json.service
rj ALL=(root) NOPASSWD: /usr/bin/systemctl restart --no-block rb2-lidar-map-json.service

rj ALL=(root) NOPASSWD: /usr/bin/systemctl restart rb2-wifi-dual-loss-return.service
rj ALL=(root) NOPASSWD: /usr/bin/systemctl restart --no-block rb2-wifi-dual-loss-return.service

# Bouton « RÉTABLIR Wi-Fi Pi5 (RB2-ROS) » de la page de secours.
rj ALL=(root) NOPASSWD: /usr/bin/systemctl restart rb2-ap-ip.service
rj ALL=(root) NOPASSWD: /usr/bin/systemctl restart --no-block rb2-ap-ip.service
rj ALL=(root) NOPASSWD: /usr/bin/systemctl restart hostapd.service
rj ALL=(root) NOPASSWD: /usr/bin/systemctl restart --no-block hostapd.service
